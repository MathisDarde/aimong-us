# Neon connection string (Neon dashboard > Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/aimong_us?sslmode=require
PORT=3000
# Web origin allowed by CORS
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
# Comma-separated IPs or CIDR ranges of the reverse proxies in front of the API (empty in dev)
TRUSTED_PROXIES=
# OpenAI-compatible endpoint used by the AI players (defaults to Scaleway Generative APIs)
AI_BASE_URL=https://api.scaleway.ai/v1
# Scaleway API secret key (Scaleway console > IAM > API keys). AI players stay silent when unset
AI_API_KEY=
# Scaleway Generative APIs model id
AI_MODEL=deepseek-v4.1-flash
# Dev only: always seat the maximum number of AI players, to test them
FORCE_MAX_AIS=false
